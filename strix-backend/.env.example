# ── OSIRIS Strix backend — copy to .env, gitignored, do NOT commit ──
#
# SECURITY: this service wraps an autonomous exploitation engine. Run it PRIVATE
# (localhost / your own trusted network) only. Never expose it to the public
# internet, and only ever point it at targets you own or are authorized to test.

# Shared secret between OSIRIS and this backend. MUST equal OSIRIS's STRIX_KEY.
# Generate one with:  openssl rand -hex 32
OSIRIS_KEY=

# LLM that drives Strix's agents. Examples:
#   anthropic/claude-sonnet-4.6   |   openai/gpt-5   |   google/gemini-3-pro
STRIX_LLM=
LLM_API_KEY=

# Optional tuning.
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT=3600
# STRIX_BIN=strix
# LLM_API_BASE=            # custom endpoint (e.g. local Ollama)
# PERPLEXITY_API_KEY=      # enables Strix's web-search capability
# STRIX_REASONING_EFFORT=medium
