# ═══════════════════════════════════════════════════════════════════════════
#  OSIRIS — Environment Template
#  Copy this file to `.env` (or `.env.local`) and fill in values as needed.
#
#  IMPORTANT — read before filling anything in:
#  OSIRIS works fully WITHOUT any third-party API keys. Aviation, maritime,
#  satellites, fires, earthquakes, weather, news, CVEs, etc. all use public
#  keyless feeds (adsb.lol, celestrak.org, NASA FIRMS open CSV, USGS, …).
#
#  As of this revision the application code only actually reads SCANNER_URL
#  and SCANNER_KEY. The other keys below are OPTIONAL and reserved for higher
#  rate limits / future data sources — set them only if you extend the code or
#  hit rate limits on the public feeds.
# ═══════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────
#  RECON SCANNER BACKEND  ── the ONLY keys the current code consumes ──
#  Powers the RECON toolkit (quick/ssl/headers/rdns/subdomains/tech/whois/
#  geoloc/vuln scans). Requires running the separate OSIRIS scanner backend.
#  SCANNER_KEY here MUST equal the backend's OSIRIS_KEY. Generate one with:
#      openssl rand -hex 32
#  Leave both empty to simply disable the RECON features (UI returns 503).
# ─────────────────────────────────────────────────────────────────────────
SCANNER_URL=
SCANNER_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  STRIX — AUTONOMOUS PENTESTING (advanced, optional, OFF by default)
#  Wires OSIRIS to a PRIVATE self-hosted Strix backend (see strix-backend/).
#  Strix actively EXPLOITS vulnerabilities — only ever point it at targets you
#  own or are explicitly authorized to test.
#
#  ⚠ SECURITY: the feature is inert unless ALL THREE below are set. NEVER set
#  them on a public/anonymous deployment — that would expose an autonomous
#  exploitation engine to anonymous users. Run it private (localhost) only.
#    STRIX_URL      → your Strix backend, e.g. http://127.0.0.1:8700
#    STRIX_KEY      → shared secret; MUST equal the backend's OSIRIS_KEY
#    OPERATOR_KEY   → separate secret you type into the OSIRIS Strix panel
#  Generate secrets with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────
STRIX_URL=
STRIX_KEY=
OPERATOR_KEY=
# Set to 1 ONLY to allow testing your own internal/RFC1918 assets (off by default).
STRIX_ALLOW_INTERNAL=


# ─────────────────────────────────────────────────────────────────────────
#  OPTIONAL DATA-SOURCE KEYS  (not read by current code — future / upgrades)
# ─────────────────────────────────────────────────────────────────────────

# Google Gemini — IMAGE GEOLOCATION (the GEO panel, POST /api/geolocate).
# Powers the photo → location analysis feature (upload a photo, Gemini vision
# estimates where on Earth it was taken). Without this key the GEO panel returns
# 503 and every other layer keeps working. Free tier available; create a key in
# Google AI Studio, then set it here.
#   Get it: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude — IMAGE GEOLOCATION (alternate vision provider for the GEO
# panel). Optional second/third provider alongside Gemini — lets you run
# combined multi-provider analysis (select multiple providers in the GEO panel
# and compare results). Without this key the GEO panel simply won't offer
# Claude as a selectable provider.
#   Get it: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# GeoInfer — IMAGE GEOLOCATION (ML-based image-clustering geolocation,
# alternate/combined provider for the GEO panel). Unlike Gemini/Claude this is
# a pure clustering model — no textual reasoning, just ranked location
# clusters with a radius-based confidence estimate.
#   Get it: https://geoinfer.com/
GEOINFER_API_KEY=

# NASA FIRMS — active wildfire hotspots.
# Free, instant. Enter an email at the page below and the MAP_KEY is emailed
# to you (looks like 'abcdef1234567890abcdef1234567890'). Limit: 5000 req /
# 10 min. The app already uses the keyless FIRMS CSV; a key only matters if
# you switch to the per-area FIRMS API.
#   Get it: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=

# OpenSky Network — aviation (higher rate limits than the keyless feed).
# Free account. Since March 2025 OpenSky uses OAuth2 (username/password auth
# is dropped). Create an account, open the Account page, create a new API
# client, and copy the client_id / client_secret.
#   Get it: https://opensky-network.org/  (Account → API client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# N2YO — satellite tracking / pass predictions.
# Free. Register, then Profile page → scroll down → "generate API key".
# The key cannot be changed once issued. Limit: 1000 req / hour.
#   Get it: https://www.n2yo.com/login/register/  (then Profile)
N2YO_API_KEY=

# aisstream.io — live maritime AIS vessel positions via WebSocket.
# Free. Register, then create a key on the API Keys page. Used in the
# subscription message to wss://stream.aisstream.io/v0/stream.
#   Get it: https://aisstream.io/  (sign up → API Keys)
AIS_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  VOICE CONTROL (OpenAI Realtime API)
# ─────────────────────────────────────────────────────────────────────────
# Powers the voice control feature (say commands, the app executes them).
# Uses OpenAI's Realtime API for low-latency voice interaction. Leave empty
# to disable — the mic control will be hidden and the route returns 503.
#   Get it: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: Override the realtime model (defaults to gpt-4o-realtime-preview)
OPENAI_REALTIME_MODEL=

# Optional: Cost caps in USD for voice sessions (defaults: soft=2, hard=5)
VOICE_COST_SOFT_CAP_USD=2
VOICE_COST_HARD_CAP_USD=5


# ─────────────────────────────────────────────────────────────────────────
#  RUNTIME
# ─────────────────────────────────────────────────────────────────────────
# Host port the web UI is published on (container always listens on 3000).
# Change this if 3000 is already taken on your host.
OSIRIS_PORT=3000

# Set by the Docker image already — override only if needed.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0
