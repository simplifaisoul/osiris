{
  "name": "@osiris/worldstate-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "collect:gdacs": "COLLECT_ONCE=1 COLLECTOR_SOURCE=gdacs-disasters tsx src/index.ts",
    "collect:eonet:volcanoes": "COLLECT_ONCE=1 COLLECTOR_SOURCE=nasa-eonet-volcanoes tsx src/index.ts",
    "collect:firms:modis": "COLLECT_ONCE=1 COLLECTOR_SOURCE=nasa-firms-modis tsx src/index.ts",
    "collect:firms:viirs": "COLLECT_ONCE=1 COLLECTOR_SOURCE=nasa-firms-viirs tsx src/index.ts",
    "collect:usgs": "COLLECT_ONCE=1 COLLECTOR_SOURCE=usgs-earthquakes tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "ingest:fixture": "tsx src/commands/ingest-fixture.ts",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "vitest run --exclude test/postgres-store.integration.test.ts --exclude test/usgs-live.test.ts",
    "test:integration": "node -e \"if (!process.env.TEST_DATABASE_URL) throw new Error('TEST_DATABASE_URL is required for integration tests')\" && vitest run test/postgres-store.integration.test.ts",
    "test:live": "RUN_LIVE_TESTS=1 vitest run test/usgs-live.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "eslint": "^10.7.0",
    "globals": "^16.5.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
