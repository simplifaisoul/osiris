# ═══════════════════════════════════════════════════════════════════════════
#  OSIRIS — Environment Template
#  Copy this file to `.env` (or `.env.local`) and fill in values as needed.
#
#  IMPORTANT — read before filling anything in:
#  OSIRIS connected profile works partially without third-party API keys. Aviation, maritime,
#  satellites, fires, earthquakes, weather, news, CVEs, etc. all use public
#  keyless feeds (adsb.lol, celestrak.org, NASA FIRMS open CSV, USGS, …).
#
#  SPYS_AIRGAP disables all public connectors. Foundation settings below are
#  mandatory in production and deliberately fail closed when missing.
# ═══════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────
#  RECON SCANNER BACKEND  ── the ONLY keys the current code consumes ──
#  Powers the RECON toolkit (quick/ssl/headers/rdns/subdomains/tech/whois/
#  geoloc/vuln scans). Requires running the separate OSIRIS scanner backend.
#  SCANNER_KEY here MUST equal the backend's OSIRIS_KEY. Generate one with:
#      openssl rand -hex 32
#  Leave both empty to simply disable the RECON features (UI returns 503).
# ─────────────────────────────────────────────────────────────────────────
SCANNER_URL=
SCANNER_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  OPTIONAL DATA-SOURCE KEYS  (not read by current code — future / upgrades)
# ─────────────────────────────────────────────────────────────────────────

# NASA FIRMS — active wildfire hotspots.
# Free, instant. Enter an email at the page below and the MAP_KEY is emailed
# to you (looks like 'abcdef1234567890abcdef1234567890'). Limit: 5000 req /
# 10 min. The app already uses the keyless FIRMS CSV; a key only matters if
# you switch to the per-area FIRMS API.
#   Get it: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=

# OpenSky Network — aviation (higher rate limits than the keyless feed).
# Free account. Since March 2025 OpenSky uses OAuth2 (username/password auth
# is dropped). Create an account, open the Account page, create a new API
# client, and copy the client_id / client_secret.
#   Get it: https://opensky-network.org/  (Account → API client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# N2YO — satellite tracking / pass predictions.
# Free. Register, then Profile page → scroll down → "generate API key".
# The key cannot be changed once issued. Limit: 1000 req / hour.
#   Get it: https://www.n2yo.com/login/register/  (then Profile)
N2YO_API_KEY=

# aisstream.io — live maritime AIS vessel positions via WebSocket.
# Free. Register, then create a key on the API Keys page. Used in the
# subscription message to wss://stream.aisstream.io/v0/stream.
#   Get it: https://aisstream.io/  (sign up → API Keys)
AIS_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  RUNTIME
# ─────────────────────────────────────────────────────────────────────────
# Host port the web UI is published on (container always listens on 3000).
# Change this if 3000 is already taken on your host.
OSIRIS_PORT=3000

# Comma-separated list of public Telegram channel usernames (no @) to scrape
# for the "Telegram OSINT" map layer. Overrides the curated default set.
# Channels must have web preview enabled (most well-known OSINT channels do).
# Default if unset:
#   osintdefender,insiderpaper,aljazeeraenglish,nexta_live,war_monitor
# OSIRIS_TELEGRAM_CHANNELS=

# Set by the Docker image already — override only if needed.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0


# ─────────────────────────────────────────────────────────────────────────
#  KAM / SPYS FOUNDATION (Phase 1)
# ─────────────────────────────────────────────────────────────────────────

# OSIRIS_CONNECTED permits explicitly configured public connectors.
# SPYS_AIRGAP blocks them and is the secure default.
DEPLOYMENT_PROFILE=SPYS_AIRGAP
ENVIRONMENT=production
FOUNDATION_API_URL=http://foundation-api:8000

# Database password is supplied by a mounted secret file, never inline.
DATABASE_URL=postgresql+asyncpg://kam_app@postgres:5432/kam
DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
REQUIRED_SCHEMA_REVISION=0001_foundation
# Compose host paths used only to create the mounted Docker secrets.
POSTGRES_PASSWORD_SOURCE_FILE=./secrets/postgres_password

# Institution IAM is the only identity authority. Do not put client secrets here.
AUTH_REQUIRED=true
OIDC_ISSUER=https://institution-iam.example.invalid/realms/kam
OIDC_JWKS_URL=https://institution-iam.example.invalid/realms/kam/protocol/openid-connect/certs
OIDC_AUDIENCE=kam-multi-int
OIDC_JWKS_CACHE_SECONDS=300
# The API verifies MFA assurance and device identity from signed IAM claims.
OIDC_MFA_REQUIRED=true
OIDC_MFA_AMR_VALUE=mfa
# Optional comma-separated institution assurance contexts accepted as MFA.
OIDC_MFA_ACR_VALUES=
OIDC_DEVICE_CLAIM=device_id
# Existing Docker network that reaches only the internal Institution IAM.
INSTITUTION_IAM_DOCKER_NETWORK=institution-iam
SESSION_IDLE_TIMEOUT_SECONDS=900
LOGIN_LOCKOUT_OWNER=INSTITUTION_IAM

# Audit integrity key is supplied by OpenBao/KMS integration as a mounted file.
OPENBAO_ADDR=https://openbao.service:8200
OPENBAO_ROLE=kam-api
AUDIT_HMAC_KEY_FILE=/run/secrets/audit_hmac_key
AUDIT_HMAC_KEY_SOURCE_FILE=./secrets/audit_hmac_key
AUDIT_RETENTION_YEARS=5
SIEM_ENABLED=false
SIEM_CEF_ENDPOINT=
DEFAULT_TIMEZONE=Europe/Istanbul

# Observability and policy baselines.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_METRICS_ENABLED=true
PUBLIC_CONNECTORS_ENABLED=false
TENDER_REQUIREMENTS_CONFIG=/etc/kam/tender-requirements.json
CURRENCY_BASE=TRY
CURRENCY_ALLOWED=TRY,USD,EUR
CURRENCY_SCALE=4
DEMAT_YELLOW_DAYS=92
DEMAT_RED_DAYS=31

# Telemetry is opt-in. No raw client IP is forwarded by the application.
TELEMETRY_ENABLED=false
UMAMI_ENDPOINT=
UMAMI_WEBSITE_ID=

# --- Phase 2: Ingestion connector SDK ---
# URL the Next.js app uses to query connector health from the ingestion service.
INGESTION_API_URL=http://ingestion:8000
# Directory of per-connector secret files (one file per manifest required_secret).
CONNECTOR_SECRET_DIR=/run/secrets/connectors
# Connector reliability policy (SDK defaults; safe to leave as-is).
CONNECTOR_MAX_RETRIES=5
CONNECTOR_CIRCUIT_FAILURE_THRESHOLD=5
CONNECTOR_CIRCUIT_RESET_SECONDS=30
# Transports for the remaining Phase 2 scope. Empty = not wired yet; the SDK
# still runs and reports connector state without them.
KAFKA_BOOTSTRAP_SERVERS=
RAW_OBJECT_STORE_ENDPOINT=
RAW_OBJECT_STORE_BUCKET=kam-raw-observations
