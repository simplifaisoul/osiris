# ═══════════════════════════════════════════════════════════════════════════
#  OSIRIS — Environment Template
#  Copy this file to `.env` (or `.env.local`) and fill in values as needed.
#
#  IMPORTANT — read before filling anything in:
#  OSIRIS works fully WITHOUT any third-party API keys. Aviation, maritime,
#  satellites, fires, earthquakes, weather, news, CVEs, etc. all use public
#  keyless feeds (adsb.lol, celestrak.org, NASA FIRMS open CSV, USGS, …).
#
#  The dashboard and optional World-State services read only the settings
#  relevant to the features you run. Third-party data-source keys remain
#  optional unless their individual comments say otherwise.
# ═══════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────
#  RECON SCANNER BACKEND
#  Powers the RECON toolkit (quick/ssl/headers/rdns/subdomains/tech/whois/
#  geoloc/vuln scans). Requires running the separate OSIRIS scanner backend.
#  SCANNER_KEY here MUST equal the backend's OSIRIS_KEY. Generate one with:
#      openssl rand -hex 32
#  Leave both empty to simply disable the RECON features (UI returns 503).
# ─────────────────────────────────────────────────────────────────────────
SCANNER_URL=
SCANNER_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  OPTIONAL AI / INTEGRATION SETTINGS
#  Gemini endpoints rotate through the non-empty keys below. Webhook and SDK
#  endpoints fail closed when their corresponding secrets are unset.
# ─────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=

INTEL_URL=
INTEL_PORT=4000
SDK_INGEST_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_FORWARD_URL=
UMAMI_WEBSITE_ID=


# ─────────────────────────────────────────────────────────────────────────
#  OPTIONAL DATA-SOURCE KEYS
# ─────────────────────────────────────────────────────────────────────────

# NASA FIRMS — active wildfire hotspots.
# Free, instant. Enter an email at the page below and the MAP_KEY is emailed
# to you (looks like 'abcdef1234567890abcdef1234567890'). Limit: 5000 req /
# 10 min. The app already uses the keyless FIRMS CSV; a key only matters if
# you switch to the per-area FIRMS API.
#   Get it: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=

# OpenSky Network — aviation (higher rate limits than the keyless feed).
# Free account. Since March 2025 OpenSky uses OAuth2 (username/password auth
# is dropped). Create an account, open the Account page, create a new API
# client, and copy the client_id / client_secret.
#   Get it: https://opensky-network.org/  (Account → API client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# N2YO — satellite tracking / pass predictions.
# Free. Register, then Profile page → scroll down → "generate API key".
# The key cannot be changed once issued. Limit: 1000 req / hour.
#   Get it: https://www.n2yo.com/login/register/  (then Profile)
N2YO_API_KEY=

# aisstream.io — live maritime AIS vessel positions via WebSocket.
# Free. Register, then create a key on the API Keys page. Used in the
# subscription message to wss://stream.aisstream.io/v0/stream.
#   Get it: https://aisstream.io/  (sign up → API Keys)
AIS_API_KEY=


# ──────────────────────────────────────────────────────────────────────────
#  WORLD-STATE STORAGE (Phase 1)
#  Used by docker-compose.worldstate.yml. These values are local-development
#  placeholders; replace the password before using the database anywhere
#  other than the loopback-only default binding. Compose passes POSTGRES_* to
#  migration/collector services as discrete PG settings, so reserved password
#  characters are not interpolated into a URL. DATABASE_URL is only for tools
#  run directly on the host; URL-encode credentials there.
# ─────────────────────────────────────────────────────────────────────────
POSTGRES_DB=osiris_worldstate
POSTGRES_USER=osiris
POSTGRES_PASSWORD=osiris-local-dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://osiris:osiris-local-dev@127.0.0.1:5432/osiris_worldstate

# In a real .env, single-quote passwords containing Compose-significant
# characters such as `$` or `#` so the dotenv parser preserves them literally.

# Absolute in-container archive path. docker-compose.worldstate.yml maps the
# host's pre-created ./archive directory here for the active collector.
RAW_ARCHIVE_PATH=/archive

# Collector-to-dashboard URL for future compatibility/health checks. The
# host-gateway address is appropriate when OSIRIS runs in its existing stack.
OSIRIS_BASE_URL=http://host.docker.internal:3000

# USGS collector scheduling and safety bounds. The collector runs immediately
# on startup, then waits five minutes after each completed attempt cycle.
USGS_EARTHQUAKE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson
COLLECT_INTERVAL_MS=300000
COLLECT_ON_STARTUP=1
MAX_FETCH_ATTEMPTS=3
MAX_RESPONSE_BYTES=26214400
REQUEST_TIMEOUT_MS=10000
RETRY_BASE_MS=500
STALE_RUN_AFTER_MS=900000
COLLECTOR_LOG_LEVEL=info

# Bounded PostgreSQL connection and per-query/statement/lock waits.
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000

# One-shot migration connection/DDL bounds. Connection timeout is seconds;
# PostgreSQL statement and lock timeouts are milliseconds.
MIGRATION_DB_CONNECT_TIMEOUT_SECONDS=10
MIGRATION_DB_STATEMENT_TIMEOUT_MS=120000
MIGRATION_DB_LOCK_TIMEOUT_MS=15000

# The collector runs without root privileges. These defaults match the Node
# image's `node` user and should also own the host ./archive directory.
COLLECTOR_UID=1000
COLLECTOR_GID=1000
COLLECTOR_HEALTH_PORT=4001


# ─────────────────────────────────────────────────────────────────────────
#  RUNTIME
# ─────────────────────────────────────────────────────────────────────────
# Host port the web UI is published on (container always listens on 3000).
# Change this if 3000 is already taken on your host.
OSIRIS_PORT=3000

# Reserved for the planned configurable Telegram source adapter. The current
# /api/news implementation does not read this value yet.
# OSIRIS_TELEGRAM_CHANNELS=

# Set to 1 only when intentionally running tests that contact live providers.
RUN_LIVE_TESTS=0

# Set by the Docker image already — override only if needed.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0
